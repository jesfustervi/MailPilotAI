{
    "manifest_version": 3,
    "name": "MailMind - AI Local Analyst",
    "version": "1.0.0",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "sidePanel",
        "unlimitedStorage"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "action": {
        "default_title": "Open MailMind"
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.zoho.com/*",
                "https://mail.zoho.eu/*"
            ],
            "js": [
                "src/content/zoho-adapter.ts"
            ],
            "run_at": "document_idle"
        }
    ]
}